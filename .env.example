# Không bắt buộc: docker compose đã có giá trị mặc định cho tất cả biến dưới đây.
# Muốn đổi thì sao chép file này thành .env rồi sửa (KHÔNG commit .env).

# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=ooad_busticket
MYSQL_USER=app_user
MYSQL_PASSWORD=changeme_app

# Backend
DEBUG=true
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
SMS_MOCK=true                       # true: API trả mã OTP trong trường mock_otp (không gửi SMS thật)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_DEMO_DATA=true                 # false: không nạp dữ liệu mẫu khi khởi động
